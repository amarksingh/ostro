{
  "name": "@ostro/ostro",
  "version": "2.0.0-alpha.1",
  "description": "OstroJS MVC framework for NodeJS",
  "keywords": [
    "framework",
    "ostrojs",
    "mvc",
    "MVC framework",
    "nodejs framework"
  ],
  "author": "amar",
  "license": "MIT",
  "scripts": {
    "test": "npx c8 npx jest",
    "dev": "npm run development",
    "development": "mix",
    "watch": "mix watch",
    "watch-poll": "mix watch -- --watch-options-poll=1000",
    "hot": "mix watch --hot",
    "prod": "npm run production",
    "build": "rm -rf build && tsc -p tsconfig.build.json && node -e 'const fs=require(\"fs\"); [\".env.example\",\".gitignore\",\"README.md\",\"LICENSE.md\",\"assistant\",\"webpack.mix.js\"].forEach(f=>{if(fs.existsSync(f))fs.copyFileSync(f,\"build/\"+f)}); [\"public\",\"resources\",\"storage\"].forEach(d=>{if(fs.existsSync(d))fs.cpSync(d,\"build/\"+d,{recursive:true})}); const pkg=JSON.parse(fs.readFileSync(\"package.json\",\"utf8\")); pkg.scripts=pkg.scripts||{}; pkg.scripts[\"server:start\"]=\"node app.js\"; fs.writeFileSync(\"build/package.json\",JSON.stringify(pkg,null,2)+\"\\n\");' && npm run prepare-package",
    "build:clean": "rm -rf build && npm run build",
    "server:start": "ts-node app.ts",
    "prepare-package": "node scripts/prepare-package.js",
    "clean": "rm -rf build coverage"
  },
  "dependencies": {
    "@ostro/framework": "^2.0.0-alpha.1"
  },
  "devDependencies": {
    "@popperjs/core": "^2.10.2",
    "@types/node": "^22.0.0",
    "axios": "^1.10.0",
    "laravel-mix": "^6.0.6",
    "lodash": "^4.17.21",
    "postcss": "^8.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "engineStrict": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrojs/ostro.git"
  },
  "bugs": {
    "url": "https://github.com/ostrojs/ostro/issues"
  },
  "homepage": "https://github.com/ostrojs/ostro#readme",
  "main": "app.ts",
  "types": "app.ts",
  "files": [
    "app",
    "bootstrap",
    "config",
    "database",
    "public",
    "resources",
    "routes",
    "storage",
    "build",
    "app.ts",
    "assistant",
    ".env.example",
    "webpack.mix.js",
    "tsconfig.json",
    "tsconfig.build.json",
    ".gitignore",
    "README.md",
    "LICENSE.md"
  ]
}
