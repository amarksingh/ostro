{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./build",
    "rootDir": ".",
    "paths": {
      "~/*": [
        "./*"
      ]
    },
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strict": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "./*.ts",
    "app/**/*.ts",
    "bootstrap/**/*.ts",
    "config/**/*.ts",
    "database/**/*.ts",
    "routes/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "test",
    "build",
    "jest.config.ts"
  ]
}
